App(
    appid="nearby_radar",
    name="BLE Radar",
    apptype=FlipperAppType.MENUEXTERNAL,
    entry_point="nearby_radar_app",
    requires=["gui", "bt", "rpc_start"],
    stack_size=4 * 1024,
    icon="A_GPIO_14",
    order=7,
    fap_category="Bluetooth",
    fap_description="Onboard BLE finding, proximity guidance and calibrated range estimates",
    fap_version="1.4",
)

App(
    appid="wifi_radar",
    name="WiFi Radar",
    apptype=FlipperAppType.MENUEXTERNAL,
    entry_point="nearby_radar_app",
    requires=["gui", "expansion_start", "rpc_start"],
    stack_size=4 * 1024,
    icon="A_GPIO_14",
    order=8,
    cflags=["-DRADAR_WIFI_ONLY=1"],
    fap_category="WiFi",
    fap_description="Passive WiFi discovery, proximity guidance and calibrated range estimates",
    fap_version="1.4",
)
