App(
    appid="nearby_radar",
    name="BLE Radar",
    apptype=FlipperAppType.MENUEXTERNAL,
    entry_point="nearby_radar_app",
    requires=["gui", "expansion_start", "rpc_start"],
    stack_size=4 * 1024,
    icon="A_GPIO_14",
    order=7,
    fap_category="Bluetooth",
    fap_description="Passive BLE discovery, name filter and RSSI target tracking",
    fap_version="1.1",
)

App(
    appid="wifi_radar",
    name="WiFi Radar",
    apptype=FlipperAppType.MENUEXTERNAL,
    entry_point="nearby_radar_app",
    requires=["gui", "expansion_start", "rpc_start"],
    stack_size=4 * 1024,
    icon="A_GPIO_14",
    order=8,
    cflags=["-DRADAR_WIFI_ONLY=1"],
    fap_category="WiFi",
    fap_description="Passive WiFi access point discovery and RSSI target tracking",
    fap_version="1.1",
)
