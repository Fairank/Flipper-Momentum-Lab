Import("env")

env.Append(
    LINT_SOURCES=[Dir(".")],
)

libenv = env.Clone(FW_LIB_NAME="flipper${TARGET_HW}")
libenv.Append(
    CPPPATH=[
        "#/lib/stm32wb_copro/wpan/interface/patterns/ble_thread/tl",
    ]
)
libenv.ApplyLibFlags()


lib = libenv.StaticLibrary(
    "${FW_LIB_NAME}",
    libenv.KeepAssemblyUnits(
        env.get("TARGET_CFG").gatherSources(), ["stm32wb55_startup.c"]
    ),
)
libenv.Install("${LIB_DIST_DIR}", lib)
Return("lib")
